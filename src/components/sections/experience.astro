---
import { experienceData } from "../../data/history";
---

<section id="experience" class="py-10 md:py-16 scroll-mt-20 md:scroll-mt-0">
  <h2 class="text-xs font-medium uppercase tracking-widest text-ink mb-6 md:mb-10">
    Experience
  </h2>

  <div class="flex flex-col">
    {
      experienceData.map((item, i) => (
        <div class={`py-6 md:py-8 ${i > 0 ? "border-t border-hairline" : ""}`}>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
            <h3 class="text-lg font-bold text-ink">{item.title}</h3>
            <span class="text-sm text-muted">{item.date}</span>
          </div>

          <div class="text-sm text-muted mb-3">{item.company}</div>

          <p class="text-base text-ink/90 leading-relaxed max-w-xl">
            {item.description}
          </p>
        </div>
      ))
    }
  </div>
</section>
