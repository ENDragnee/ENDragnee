---
import { config } from "../../data/config";
import SocialButton from "../ui/social-button.astro";
import { ArrowRight, Terminal, Calendar, ExternalLink } from "lucide-react";

// Sort occupations chronologically: current roles first, then by start year descending
const sortedOccupations = [...config.listOfOccupations].sort((a, b) => {
  if (a.current && !b.current) return -1;
  if (!a.current && b.current) return 1;
  return parseInt(b.fromDate) - parseInt(a.fromDate);
});
---

<section id="hero" class="flex flex-col gap-12 py-12 md:py-24">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
    {/* --- Left Column: Intro --- */}
    <div class="md:col-span-7 flex flex-col gap-8 order-2 md:order-1">
      {/* Terminal Header decoration */}
      <div
        class="flex items-center gap-2 text-crimson-500 font-mono text-sm mb-2"
      >
        <Terminal size={16} />
        <span>~/portfolio/readme.md</span>
      </div>

      <div class="space-y-4">
        <h1
          class="text-5xl sm:text-6xl font-extrabold tracking-tight text-ui-900 dark:text-ui-50"
        >
          {config.identity.name}<span class="text-crimson-500">.</span>
        </h1>
        <h2 class="text-2xl sm:text-3xl font-mono text-ui-600 dark:text-ui-300">
          {config.identity.role}
        </h2>
      </div>

      <p class="text-lg text-ui-600 dark:text-ui-400 leading-relaxed max-w-2xl">
        {config.identity.tagline}
      </p>

      {/* Action Bar */}
      <div class="flex flex-wrap items-center gap-4 mt-2">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium
            bg-ui-900 text-white dark:bg-white dark:text-ui-900
            hover:bg-crimson-600 dark:hover:bg-crimson-400 dark:hover:text-white
            transition-colors duration-200"
        >
          View Projects
          <ArrowRight size={18} />
        </a>

        <div class="flex gap-2">
          <SocialButton
            href={config.socials.github}
            icon="github"
            label="GitHub"
          />
          <SocialButton
            href={config.socials.linkedin}
            icon="linkedin"
            label="LinkedIn"
          />
          <SocialButton
            href={`mailto:${config.identity.email}`}
            icon="mail"
            label="Email"
          />
        </div>
      </div>
    </div>

    {/* --- Right Column: Status & Experience Timeline --- */}
    <div class="md:col-span-5 space-y-6 order-1 md:order-2">
      {/* Status Card */}
      <div
        class="p-5 rounded-xl border border-ui-200 dark:border-ui-800
            bg-ui-50/50 dark:bg-ui-900/50 backdrop-blur-sm"
      >
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-mono uppercase tracking-wider text-ui-500"
            >System Status</span
          >
          <span class="relative flex h-3 w-3">
            <span
              class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${config.status.available ? "bg-green-400" : "bg-red-400"}`}
            ></span>
            <span
              class={`relative inline-flex rounded-full h-3 w-3 ${config.status.available ? "bg-green-500" : "bg-red-500"}`}
            ></span>
          </span>
        </div>
        <p class="font-medium text-ui-900 dark:text-ui-100 text-sm">
          {config.status.message}
        </p>
      </div>

      {/* Experience History Track */}
      <div class="space-y-4">
        <div class="flex items-center justify-between px-1">
          <span class="text-xs font-mono uppercase tracking-wider text-ui-500 block">
            Experience History
          </span>
          <span class="text-[10px] font-mono text-crimson-500 dark:text-crimson-400 uppercase tracking-widest">
            {config.listOfOccupations.filter(j => j.current).length} Active
          </span>
        </div>

        <div class="flex flex-col gap-3">
          {sortedOccupations.map((job) => (
            <div
              class={`p-5 rounded-xl border transition-all duration-300 relative group
                ${job.current 
                  ? "border-crimson-500/30 dark:border-crimson-500/40 bg-linear-to-br from-white to-crimson-50/10 dark:from-ui-950 dark:to-crimson-950/10 shadow-sm" 
                  : "border-ui-200 dark:border-ui-800 bg-white dark:bg-ui-950 opacity-75 hover:opacity-100"
                }`}
            >
              {/* Highlight dot for active roles */}
              {job.current && (
                <span class="absolute top-5 right-5 flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-crimson-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-crimson-500"></span>
                </span>
              )}

              <div class="flex flex-col gap-1 pr-6">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="font-bold text-ui-900 dark:text-ui-100 group-hover:text-crimson-500 dark:group-hover:text-crimson-400 transition-colors">
                    {job.company}
                  </span>
                  {job.link && (
                    <a 
                      href={job.link} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="text-ui-400 hover:text-ui-600 dark:hover:text-ui-200 transition-colors"
                      aria-label={`Visit ${job.company} website`}
                    >
                      <ExternalLink size={13} />
                    </a>
                  )}
                </div>

                <span class="text-sm font-medium text-ui-700 dark:text-ui-300">
                  {job.role}
                </span>

                <div class="flex items-center gap-1.5 text-xs text-ui-400 dark:text-ui-500 font-mono mt-2">
                  <Calendar size={12} />
                  <span>{job.fromDate} — {job.current ? "Present" : job.endDate}</span>
                  {job.current && (
                    <span class="ml-1.5 px-1.5 py-0.5 rounded text-[10px] font-sans font-semibold uppercase tracking-wider bg-crimson-100 dark:bg-crimson-950 text-crimson-700 dark:text-crimson-300">
                      Active
                    </span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
