---
import { projectsData } from "../../data/projects";
import ProjectCard from "../ui/project-card.astro";
import { ChevronDown, ExternalLink } from "lucide-react";

const featured = projectsData.filter((p) => p.featured);
const more = projectsData.filter((p) => !p.featured);
---

<section id="projects" class="py-10 md:py-16 border-t border-hairline scroll-mt-20 md:scroll-mt-0">
  <h2 class="text-xs font-medium uppercase tracking-widest text-ink mb-6 md:mb-10">Projects</h2>

  <div class="flex flex-col">
    {featured.map((project, i) => <ProjectCard project={project} isFirst={i === 0} />)}
  </div>

  <details class="group mt-2 pt-2 border-t border-hairline">
    <summary
      class="flex items-center gap-2 py-4 min-h-11 text-sm text-muted hover:text-ink active:text-ink transition-colors cursor-pointer select-none [&::-webkit-details-marker]:hidden list-none"
    >
      <ChevronDown
        size={14}
        className="transition-transform group-open:rotate-180"
      />
      <span>{more.length} more projects</span>
    </summary>

    <div class="flex flex-col">
      {
        more.map((project) => (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between gap-4 py-3 min-h-11 border-t border-hairline group/row hover:text-accent active:text-accent transition-colors"
          >
            <span class="flex flex-col sm:flex-row sm:items-baseline sm:gap-3 min-w-0">
              <span class="font-medium text-ink group-hover/row:text-accent transition-colors truncate">
                {project.title}
              </span>
              <span class="text-sm text-muted truncate">
                {project.tech.join(" · ")}
              </span>
            </span>
            <ExternalLink
              size={14}
              className="text-muted group-hover/row:text-accent transition-colors shrink-0"
            />
          </a>
        ))
      }
    </div>
  </details>
</section>
