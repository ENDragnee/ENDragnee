---
import { skillData } from "../../data/skills";
---

<section id="skills" class="py-10 md:py-16 border-t border-hairline scroll-mt-20 md:scroll-mt-0">
  <h2 class="text-xs font-medium uppercase tracking-widest text-ink mb-6 md:mb-10">Skills</h2>

  <div class="flex flex-col gap-6">
    {
      skillData.map((category) => (
        <div>
          <h3 class="text-sm text-muted mb-1">{category.title}</h3>
          <p class="text-base text-ink leading-relaxed max-w-xl">
            {category.skills.join(" · ")}
          </p>
        </div>
      ))
    }
  </div>
</section>
