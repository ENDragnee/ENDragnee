---
import { Github, Linkedin, Twitter, Mail } from "lucide-react";

interface Props {
  href: string;
  icon: "github" | "linkedin" | "twitter" | "mail";
  label: string;
}

const { href, icon, label } = Astro.props;

const IconMap = {
  github: Github,
  linkedin: Linkedin,
  twitter: Twitter,
  mail: Mail,
};

const IconComponent = IconMap[icon];
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class="group flex items-center gap-2.5 py-3 min-h-11 text-muted hover:text-accent active:text-accent transition-colors"
>
  <IconComponent size={16} />
  <span class="text-sm">{label}</span>
</a>
