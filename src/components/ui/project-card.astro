---
import { ExternalLink, Github } from "lucide-react";
import type { Project } from "../../data/projects";

interface Props {
  project: Project;
  isFirst?: boolean;
}

const { project, isFirst } = Astro.props;
---

<article class={`py-5 md:py-6 ${isFirst ? "" : "border-t border-hairline"}`}>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
    <a
      href={project.link}
      target="_blank"
      rel="noopener noreferrer"
      class="text-lg font-bold text-ink hover:text-accent transition-colors"
    >
      {project.title}
    </a>
    <div class="flex items-center shrink-0 text-muted -mr-2.5">
      {
        project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Repo"
            class="inline-flex items-center justify-center w-11 h-11 hover:text-accent active:text-accent transition-colors"
          >
            <Github size={16} />
          </a>
        )
      }
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Live Demo"
        class="inline-flex items-center justify-center w-11 h-11 hover:text-accent active:text-accent transition-colors"
      >
        <ExternalLink size={16} />
      </a>
    </div>
  </div>

  <p class="text-base text-ink/90 leading-relaxed mt-2 mb-2 max-w-xl">
    {project.description}
  </p>

  <p class="text-sm text-muted">{project.tech.join(" · ")}</p>
</article>
